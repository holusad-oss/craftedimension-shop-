# Copy to .env for local use, or set these in Render → Environment. Never commit real keys.
PORT=3000

# Free persistent database (Neon or Supabase Postgres). Leave empty to use data/db.json locally.
# Example: postgres://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
ADMIN_PASSWORD=change-me

# Stripe (use TEST keys: sk_test_… and the webhook signing secret whsec_…)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Live keys (sk_live_…) are refused unless this is set to 1 — only when you are ready to go live.
STRIPE_ALLOW_LIVE=0
# Public site address used for Stripe success/cancel links (optional; defaults to the request host)
PUBLIC_URL=https://craftedimension-shop.onrender.com

# Owner notifications by email (optional — if unset, orders, custom requests and contact messages are written to the server log).
# Shop inbox. SMTP_HOST and the SMTP login below are still required to send; those secrets are unchanged.
OWNER_EMAIL=teamcraftedimensions@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Public From on order, custom-print and contact mail. If unset, the server uses this same address.
# Reply-To defaults to it as well (set SMTP_REPLY_TO only to override). No new credentials.
SMTP_FROM=teamcraftedimensions@gmail.com

# Copy to .env for local use, or set these in Render → Environment. Never commit real keys.
PORT=3000
ADMIN_PASSWORD=change-me

# Stripe (use TEST keys: sk_test_… and the webhook signing secret whsec_…)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Live keys (sk_live_…) are refused unless this is set to 1 — only when you are ready to go live.
STRIPE_ALLOW_LIVE=0
# Public site address used for Stripe success/cancel links (optional; defaults to the request host)
PUBLIC_URL=https://craftedimension-shop.onrender.com

# Owner order notifications by email (optional — if unset, orders are written to the server log)
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
